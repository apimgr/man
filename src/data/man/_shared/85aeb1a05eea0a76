     bbiiooccttll — storage management interface

SSYYNNOOPPSSIISS
     bbiiooccttll [--hhiiqqvv] [--aa _a_l_a_r_m_-_f_u_n_c_t_i_o_n] [--bb _c_h_a_n_n_e_l:_t_a_r_g_e_t[._l_u_n]]
            [--HH _c_h_a_n_n_e_l:_t_a_r_g_e_t[._l_u_n]] [--RR _c_h_u_n_k | _c_h_a_n_n_e_l:_t_a_r_g_e_t[._l_u_n]]
            [--tt _p_a_t_r_o_l_-_f_u_n_c_t_i_o_n] [--uu _c_h_a_n_n_e_l:_t_a_r_g_e_t[._l_u_n]] _d_e_v_i_c_e

     bbiiooccttll [--ddhhiiPPqqssvv] [--CC _f_l_a_g[,_._._.]] [--cc _r_a_i_d_l_e_v_e_l] [--kk _k_e_y_d_i_s_k]
            [--ll _c_h_u_n_k[,_._._.]] [--OO _c_h_u_n_k | _c_h_a_n_n_e_l:_t_a_r_g_e_t[._l_u_n]] [--pp _p_a_s_s_f_i_l_e]
