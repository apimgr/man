     _s_s_i_z_e___t
     ggeettddiirreennttrriieess(_i_n_t _f_d, _c_h_a_r _*_b_u_f, _s_i_z_e___t _n_b_y_t_e_s, _o_f_f___t _*_b_a_s_e_p);

