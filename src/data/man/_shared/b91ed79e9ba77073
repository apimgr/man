EEXXAAMMPPLLEESS
       The program below can be used to demonstrate the behavior of
       ssttrrvveerrssccmmpp().  It uses ssttrrvveerrssccmmpp() to compare the two strings given as
       its command‐line arguments.  An example of its use is the following:

           $ ..//aa..oouutt jjaann11 jjaann1100;
           jan1 < jan10

   PPrrooggrraamm ssoouurrccee

       #define _GNU_SOURCE
       #include <stdio.h>
       #include <stdlib.h>
       #include <string.h>

       int
       main(int argc, char *argv[])
       {
           int res;

           if (argc != 3) {
               fprintf(stderr, "Usage: %s <string1> <string2>\n", argv[0]);
               exit(EXIT_FAILURE);
           }

           res = strverscmp(argv[1], argv[2]);

           printf("%s %s %s\n", argv[1],
                  (res < 0) ? "<" : (res == 0) ? "==" : ">", argv[2]);

           exit(EXIT_SUCCESS);
       }

