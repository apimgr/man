/etc/wg/wg0   >   /etc/wg/wg0.pub    A#    cat    /etc/wg/wg0.pub
N+B4Nelg+4ysvbLW3qenxIwrJVE9MdjMyqrIisH7V0Y=

B#  (umask  0077;  wg‐keygen  > /etc/wg/wg0) B# wg‐keygen ‐‐pub <
