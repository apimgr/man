     ggsshhsseecc — control utility for shared secret devices

SSYYNNOOPPSSIISS
     ggsshhsseecc llaabbeell [--hhvv] _n_a_m_e _p_r_o_v _p_r_o_v _._._.
     ggsshhsseecc ssttoopp [--ffvv] _n_a_m_e _._._.
     ggsshhsseecc cclleeaarr [--vv] _p_r_o_v _._._.
