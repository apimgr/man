     ssiiggnniiffyy — cryptographically sign and verify files

SSYYNNOOPPSSIISS
     ssiiggnniiffyy --CC [--qq] [--pp _p_u_b_k_e_y] [--tt _k_e_y_t_y_p_e] --xx _s_i_g_f_i_l_e [_f_i_l_e _._._.]
     ssiiggnniiffyy --GG [--nn] [--cc _c_o_m_m_e_n_t] --pp _p_u_b_k_e_y --ss _s_e_c_k_e_y
     ssiiggnniiffyy --SS [--eennzz] [--xx _s_i_g_f_i_l_e] --ss _s_e_c_k_e_y --mm _m_e_s_s_a_g_e
