table‐rule      =  "table"  ""  string  ""  [  tableopts‐list   ]
tableopts‐list  =  tableopts‐list tableopts | tableopts tableopts
= "persist" | "const" | "file" string |
                 "{" [  tableaddr‐list  ]  "}"  tableaddr‐list  =
tableaddr‐list [ "," ] tableaddr‐spec | tableaddr‐spec tableaddr‐
spec = [ "!" ] tableaddr [ "/" mask‐bits ] tableaddr      = host‐
name | ifspec | "self" |
