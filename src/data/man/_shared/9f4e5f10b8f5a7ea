"}"  )  ]  |                  [ "ruleset‐optimization" [ "none" |
"basic" | "profile" ]] |
                 [ "optimization" [ "default" | "normal" |
                 "high‐latency" | "satellite" |
                 "aggressive" | "conservative" ] ]
                 [ "limit" ( limit‐item | "{" limit‐list "}" )  ]
|
                 [ "loginterface" ( interface‐name | "none" ) ] |
                 [ "block‐policy" ( "drop" | "return" ) ] |
                 [ "state‐policy" ( "if‐bound" | "floating" ) ]
                 [ "require‐order" ( "yes" | "no" ) ]
                 [ "fingerprints" filename ] |
                 [ "skip on" ifspec ] |
                 [  "debug" ( "none" | "urgent" | "misc" | "loud"
) ] )

pf‐rule        = action [ ( "in" | "out" ) ]
                 [ "log" [ "(" logopts ")"] ] [ "quick" ]
                 [ "on" ifspec ] [ "fastroute" | route ] [ af ] [
protospec ]
                 hosts [ filteropt‐list ]

logopts        = logopt [ "," logopts ] logopt         = "all"  |
"user" | "to" interface‐name

filteropt‐list  =  filteropt‐list filteropt | filteropt filteropt
= user | group | flags | icmp‐type | icmp6‐type | tos |
