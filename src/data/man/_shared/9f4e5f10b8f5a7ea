|
                 "{"  interface‐list "}" interface‐list = [ "!" ]
( interface‐name | interface‐group )
                 [ [ "," ] interface‐list ]  route           =  (
"route‐to" | "reply‐to" | "dup‐to" )
                 ( routehost | "{" routehost‐list "}" )
                 [ pooltype ] af             = "inet" | "inet6"

