           /* IPv6 */
           struct mif6ctl mc;
           memset(&mc, 0, sizeof(mc));
           /* Assign all mif6ctl fields as appropriate */
           mc.mif6c_mifi = mif_index;
           mc.mif6c_flags = mif_flags;
           mc.mif6c_pifi = pif_index;
           setsockopt(mrouter_s6, IPPROTO_IPV6, MRT6_ADD_MIF, &mc, sizeof(mc));

