     Create a request that is to be sent to the CCD class, and tell it to de‐
     stroy a specific geom:

           H = gctl_get_handle();
           gctl_ro_param(H, "verb", -1, "destroy geom");
           gctl_ro_param(H, "class", -1, "CCD");
           sprintf(buf, "ccd%d", ccd);
           gctl_ro_param(H, "geom", -1, buf);
           errstr = gctl_issue(H);
           if (errstr != NULL)
               err(1, "could not destroy ccd: %s", errstr);
           gctl_free(H);

