           sigset_t origmask;

           pthread_sigmask(SIG_SETMASK, &sigmask, &origmask);
           ready = epoll_wait(epfd, &events, n, timeout);
           pthread_sigmask(SIG_SETMASK, &origmask, NULL);

       The  _s_i_g_m_a_s_k  argument  may  be  specified  as  NULL,  in  which   case
       eeppoollll__ppwwaaiitt() is equivalent to eeppoollll__wwaaiitt().

