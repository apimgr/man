EEXXAAMMPPLLEESS
       The program shown below demonstrates the use of  ssttrrttooll().   The  first
       command‐line  argument  specifies  a  string from which ssttrrttooll() should
       parse a number.  The second (optional) argument specifies the  base  to
       be  used  for  the  conversion.  (This argument is converted to numeric
       form using aattooii(3), a function that performs no error checking and  has
       a  simpler  interface  than  ssttrrttooll().)   Some  examples of the results
       produced by this program are the following:

           $ ..//aa..oouutt 112233
           strtol() returned 123
           $ ..//aa..oouutt ''    112233''
           strtol() returned 123
           $ ..//aa..oouutt 112233aabbcc
           strtol() returned 123
           Further characters after number: "abc"
           $ ..//aa..oouutt 112233aabbcc 5555
           strtol: Invalid argument
           $ ..//aa..oouutt ''''
           No digits were found
           $ ..//aa..oouutt 44000000000000000000
           strtol: Numerical result out of range

   PPrrooggrraamm ssoouurrccee

       #include <errno.h>
       #include <stdio.h>
       #include <stdlib.h>

       int
       main(int argc, char *argv[])
       {
           int base;
           char *endptr, *str;
           long val;

           if (argc < 2) {
               fprintf(stderr, "Usage: %s str [base]\n", argv[0]);
               exit(EXIT_FAILURE);
           }

           str = argv[1];
           base = (argc > 2) ? atoi(argv[2]) : 0;

           errno = 0;    /* To distinguish success/failure after call */
           strtol("0", NULL, base);
           if (errno == EINVAL) {
               perror("strtol");
               exit(EXIT_FAILURE);
           }

           errno = 0;    /* To distinguish success/failure after call */
           val = strtol(str, &endptr, base);

           /* Check for various possible errors.  */

           if (errno == ERANGE) {
               perror("strtol");
               exit(EXIT_FAILURE);
           }

           if (endptr == str) {
               fprintf(stderr, "No digits were found\n");
               exit(EXIT_FAILURE);
           }

           /* If we got here, strtol() successfully parsed a number.  */

           printf("strtol() returned %ld\n", val);

           if (*endptr != '\0')        /* Not necessarily an error.  */
               printf("Further characters after number: \"%s\"\n", endptr);

           exit(EXIT_SUCCESS);
       }

