     rrppcciinnffoo — report RPC information

SSYYNNOOPPSSIISS
     rrppcciinnffoo [--mm | --ss] [_h_o_s_t]
     rrppcciinnffoo [_h_o_s_t]
     rrppcciinnffoo --TT _t_r_a_n_s_p_o_r_t _h_o_s_t _p_r_o_g_n_u_m [_v_e_r_s_n_u_m]
     rrppcciinnffoo --ll [--TT _t_r_a_n_s_p_o_r_t] _h_o_s_t _p_r_o_g_n_u_m [_v_e_r_s_n_u_m]
     rrppcciinnffoo [--nn _p_o_r_t_n_u_m] --uu _h_o_s_t _p_r_o_g_n_u_m [_v_e_r_s_n_u_m]
     rrppcciinnffoo [--nn _p_o_r_t_n_u_m] [--tt] _h_o_s_t _p_r_o_g_n_u_m [_v_e_r_s_n_u_m]
     rrppcciinnffoo --aa _s_e_r_v___a_d_d_r_e_s_s --TT _t_r_a_n_s_p_o_r_t _p_r_o_g_n_u_m [_v_e_r_s_n_u_m]
     rrppcciinnffoo --bb [--TT _t_r_a_n_s_p_o_r_t] _p_r_o_g_n_u_m _v_e_r_s_n_u_m
