     eeffiivvaarr — UEFI environment variable interaction

SSYYNNOOPPSSIISS
     eeffiivvaarr [--aabbddDDHHllLLNNppqqRRttuuww] [--nn _n_a_m_e] [--ff _f_i_l_e] [----aappppeenndd] [----aasscciiii]
            [----aattttrriibbuutteess] [----bbiinnaarryy] [----ddeelleettee] [----ddeevviiccee--ppaatthh]
            [----ffrroommffiillee _f_i_l_e] [----gguuiidd] [----hheexx] [----lliisstt--gguuiiddss] [----lliisstt]
            [----llooaadd--ooppttiioonn] [----nnaammee _n_a_m_e] [----nnoo--nnaammee] [----pprriinntt]
