     takes the structure _s_t_r_u_c_t _m_a_k_e___d_e_v___a_r_g_s _a_r_g_s, which specifies the param‐
     eters for the device creation:

           struct make_dev_args {
                   size_t           mda_size;
                   int              mda_flags;
                   struct cdevsw   *mda_devsw;
                   struct ucred    *mda_cr;
                   uid_t            mda_uid;
                   gid_t            mda_gid;
                   int              mda_mode;
                   int              mda_unit;
                   void            *mda_si_drv1;
