     iiccoonnvv — codeset conversion utility

SSYYNNOOPPSSIISS
     iiccoonnvv [--ccss] --ff _f_r_o_m___n_a_m_e --tt _t_o___n_a_m_e [_f_i_l_e _._._.]
     iiccoonnvv --ff _f_r_o_m___n_a_m_e [--ccss] [--tt _t_o___n_a_m_e] [_f_i_l_e _._._.]
