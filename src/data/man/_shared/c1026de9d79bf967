          rc.conf.local(8) for _d_a_e_m_o_n___e_x_e_c_d_i_r, _d_a_e_m_o_n___f_l_a_g_s, _d_a_e_m_o_n___l_o_g_g_e_r,
          _d_a_e_m_o_n___r_t_a_b_l_e, _d_a_e_m_o_n___t_i_m_e_o_u_t, and _d_a_e_m_o_n___u_s_e_r will override those
          defaults.

