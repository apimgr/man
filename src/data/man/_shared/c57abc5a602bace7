     kkdduummpp — display kernel trace data

SSYYNNOOPPSSIISS
     kkdduummpp [--ddHHllnnRRTTXXxx] [--ff _f_i_l_e] [--mm _m_a_x_d_a_t_a] [--PP _p_r_o_g_r_a_m] [--pp _p_i_d] [--tt _t_r_s_t_r]
