NNAAMMEE
       dnssec‐keyfromlabel - DNSSEC key generation tool

SSYYNNOOPPSSIISS
       ddnnsssseecc--kkeeyyffrroommllaabbeell {--ll label} [--33] [--aa algorithm] [--AA date/offset] [--cc
       class]  [--DD  date/offset]  [--DD  sync date/offset] [--EE engine] [--ff flag]
       [--GG] [--II date/offset] [--ii interval] [--kk] [--KK directory]  [--LL  ttl]  [--nn
       nametype]  [--PP  date/offset]  [--PP  sync  date/offset] [--pp protocol] [--RR
