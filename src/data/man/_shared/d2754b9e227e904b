           pprruunniinngg [ooffff | oonn]

           ttuunnnneell _l_o_c_a_l_-_a_d_d_r _r_e_m_o_t_e_-_a_d_d_r
           [bboouunnddaarryy _b_o_u_n_d_a_r_y_-_n_a_m_e | _s_c_o_p_e_d_-_a_d_d_r/_m_a_s_k_-_l_e_n] [mmeettrriicc _m]
