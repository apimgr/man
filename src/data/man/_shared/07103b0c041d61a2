EEXXAAMMPPLLEESS
       The program below demonstrates the use of ffrreeaadd() by parsing /bin/sh
       ELF executable in binary mode and printing its magic and class:

           $ ..//aa..oouutt;
           ELF magic: 0x7f454c46
           Class: 0x02

   PPrrooggrraamm ssoouurrccee

       #include <stdio.h>
       #include <stdlib.h>

       #define NITEMS(arr)  (sizeof(arr) / sizeof((arr)[0]))

       int
       main(void)
       {
           FILE           *fp;
           size_t         ret;
           unsigned char  buffer[4];

           fp = fopen("/bin/sh", "rb");
           if (!fp) {
               perror("fopen");
               return EXIT_FAILURE;
           }

           ret = fread(buffer, sizeof(*buffer), NITEMS(buffer), fp);
           if (ret != NITEMS(buffer)) {
               fprintf(stderr, "fread() failed: %zu\n", ret);
               exit(EXIT_FAILURE);
           }

           printf("ELF magic: %#04x%02x%02x%02x\n", buffer[0], buffer[1],
                  buffer[2], buffer[3]);

           ret = fread(buffer, 1, 1, fp);
           if (ret != 1) {
               fprintf(stderr, "fread() failed: %zu\n", ret);
               exit(EXIT_FAILURE);
           }

           printf("Class: %#04x\n", buffer[0]);

           fclose(fp);

           exit(EXIT_SUCCESS);
       }

