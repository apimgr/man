       iinntt eexxeeccvveeaatt((iinntt _d_i_r_f_d,, ccoonnsstt cchhaarr **_p_a_t_h,,
                    cchhaarr **ccoonnsstt __NNuullllaabbllee _a_r_g_v[[]],,
                    cchhaarr **ccoonnsstt __NNuullllaabbllee _e_n_v_p[[]],,
