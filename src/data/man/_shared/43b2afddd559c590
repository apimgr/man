     _i_n_t
     aacccceepptt(_i_n_t _s, _s_t_r_u_c_t _s_o_c_k_a_d_d_r _* _r_e_s_t_r_i_c_t _a_d_d_r,
         _s_o_c_k_l_e_n___t _* _r_e_s_t_r_i_c_t _a_d_d_r_l_e_n);

     _i_n_t
     aacccceepptt44(_i_n_t _s, _s_t_r_u_c_t _s_o_c_k_a_d_d_r _* _r_e_s_t_r_i_c_t _a_d_d_r,
