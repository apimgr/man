       ample,  _u_s_e_r_._m_i_m_e___t_y_p_e, _t_r_u_s_t_e_d_._m_d_5_s_u_m, _s_y_s_t_e_m_._p_o_s_i_x___a_c_l___a_c_c_e_s_s, or _s_e_‐
