NNAAMMEE
       pnmnorm - normalize the contrast in a Netpbm image


SSYYNNOOPPSSIISS
       ppnnmmnnoorrmm

       [--bbppeerrcceenntt==_p_e_r_c_e_n_t | --bbvvaalluuee==_N | --bbssiinnggllee]

       [--wwppeerrcceenntt==_p_e_r_c_e_n_t | --wwvvaalluuee==_N | --wwssiinnggllee]

