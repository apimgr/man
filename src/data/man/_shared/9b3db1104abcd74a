NNAAMMEE
       mountpoint - see if a directory or file is a mountpoint

SSYYNNOOPPSSIISS
       mmoouunnttppooiinntt [--dd|--qq] _d_i_r_e_c_t_o_r_y|_f_i_l_e

       mmoouunnttppooiinntt --xx _d_e_v_i_c_e

DDEESSCCRRIIPPTTIIOONN
       mmoouunnttppooiinntt checks whether the given _d_i_r_e_c_t_o_r_y or _f_i_l_e is mentioned in
       the _/_p_r_o_c_/_s_e_l_f_/_m_o_u_n_t_i_n_f_o file.

OOPPTTIIOONNSS
       --dd, ----ffss--ddeevvnnoo
           Show the major/minor numbers of the device that is mounted on the
           given directory.

       --qq, ----qquuiieett
           Be quiet - don’t print anything.

       ----nnooffoollllooww
           Do not follow symbolic link if it the last element of the _d_i_r_e_c_t_o_r_y
           path.

       --xx, ----ddeevvnnoo
           Show the major/minor numbers of the given blockdevice on standard
           output.

       --hh, ----hheellpp
           Display help text and exit.

       --VV, ----vveerrssiioonn
           Print version and exit.

EEXXIITT SSTTAATTUUSS
       mmoouunnttppooiinntt has the following exit status values:

       00
           success; the directory is a mountpoint, or device is block device
           on ----ddeevvnnoo

       11
           failure; incorrect invocation, permissions or system error

       3322
           failure; the directory is not a mountpoint, or device is not a
           block device on ----ddeevvnnoo

EENNVVIIRROONNMMEENNTT
       LLIIBBMMOOUUNNTT__DDEEBBUUGG=all
           enables libmount debug output.

