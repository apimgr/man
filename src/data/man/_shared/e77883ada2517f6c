NNAAMMEE
     rrttpprriioo, iiddpprriioo — execute, examine or modify a utility's or process's re‐
     altime or idletime scheduling priority

SSYYNNOOPPSSIISS
     [[iidd||rrtt]]pprriioo
     [[iidd||rrtt]]pprriioo [--]_p_i_d
     [[iidd||rrtt]]pprriioo _p_r_i_o_r_i_t_y _c_o_m_m_a_n_d [args]
     [[iidd||rrtt]]pprriioo _p_r_i_o_r_i_t_y --_p_i_d
     [[iidd||rrtt]]pprriioo --tt _c_o_m_m_a_n_d [args]
