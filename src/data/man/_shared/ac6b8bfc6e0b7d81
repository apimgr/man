       ffiinnddmmnntt ----ppoollll ----mmoouunnttppooiinntt //mmnntt//ffoooo
           Monitors mount, unmount, remount and move on _/_m_n_t_/_f_o_o.

       ffiinnddmmnntt ----ppoollll==uummoouunntt ----ffiirrsstt--oonnllyy ----mmoouunnttppooiinntt //mmnntt//ffoooo
           Waits for _/_m_n_t_/_f_o_o unmount.

       ffiinnddmmnntt ----ppoollll==rreemmoouunntt --tt eexxtt33 --OO rroo
