NNAAMMEE
     ggzziipp, gguunnzziipp, zzccaatt — compression/decompression tool using Lempel-Ziv cod‐
     ing (LZ77)

SSYYNNOOPPSSIISS
     ggzziipp [--ccddffhhkkLLllNNnnqqrrttVVvv] [--SS _s_u_f_f_i_x] _f_i_l_e [_f_i_l_e [...]]
     gguunnzziipp [--ccffhhkkLLNNqqrrttVVvv] [--SS _s_u_f_f_i_x] _f_i_l_e [_f_i_l_e [...]]
