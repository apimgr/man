     vvaalleeccttll — manage VALE network switches provided by netmap

SSYYNNOOPPSSIISS
     vvaalleeccttll  [--gg _v_a_l_e_S_S_S_:_P_P_P] [--aa _v_a_l_e_S_S_S_:_i_n_t_e_r_f_a_c_e] [--hh _v_a_l_e_S_S_S_:_i_n_t_e_r_f_a_c_e]
              [--dd _v_a_l_e_S_S_S_:_i_n_t_e_r_f_a_c_e] [--nn _i_n_t_e_r_f_a_c_e] [--rr _i_n_t_e_r_f_a_c_e]
              [--ll _v_a_l_e_S_S_S_:_P_P_P] [--ll] [--pp _v_a_l_e_S_S_S_:_P_P_P] [--PP _v_a_l_e_S_S_S_:_P_P_P]
