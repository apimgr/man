       Always decompose on the way in, then recompose on the way out.

        use Unicode::Normalize;

        while (<>) {
            $_ = NFD($_);   # decompose + reorder canonically
            ...
        } continue {
            print NFC($_);  # recompose (where possible) + reorder canonically
        }

