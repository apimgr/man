         static int
         acmephy_attach(device_t dev)
         {
             phandle_t node;

             /* PHY node is referenced from eth device, register it */
             node = ofw_bus_get_node(dev);
             OF_device_register_xref(OF_xref_from_node(node), dev);

             return (0);
         }

