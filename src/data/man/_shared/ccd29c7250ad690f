     #
     #       rpc
     #
     rpcbind         100000  portmap sunrpc portmapper
     rusersd         100002  rusers
     nfs             100003  nfsprog
     mountd          100005  mount   showmount
     walld           100008  rwall   shutdown
     sprayd          100012  spray
     llockmgr        100020
     nlockmgr        100021
     status          100024
     bootparam       100026
     keyserv         100029  keyserver

