       The ppaammttrriiss command language is much too rudimentary  to  be  used  di‐
       rectly for any serious drawing; you will probably want to use a general
       purpose programming language to generate a  temporary  ppaammttrriiss  command
       file.

       For  example, the ddrraaww__ppoollyyggoonn procedure in the C program below outputs
       ppaammttrriiss instructions to draw a regular polygon. It does this by  gener‐
       ating  a  number of vveerrtteexx instructions tracing around the perimeter of
       the corresponding circumscribed circle. (Note: The PAM  image  produced
       by piping the output of the below program into ppaammttrriiss was subsequently
       downscaled   through   ppaammssccaallee --lliinneeaarr --xxssccaallee 00..2255 --yyssccaallee 00..2255    to
       achieve an anti-aliased ⟨#antialias⟩  effect.)

       RReegguullaarr PPoollyyggoonnss

       /* ----------------------- *
        * width       = 512       *
        * height      = 512       *
        * num_attribs = 3         *
        * tupletype   = RGB_ALPHA *
        * ----------------------- */

       #include <math.h>
       #include <stdio.h>
       #include <stdlib.h>

       #define PI 3.14159265358979323844

       void draw_polygon
       (int const center_x, int const center_y, int const radius, int const sides)
       {
           printf("mode fan\n"
                  "vertex %d %d 0\n", center_x, center_y);

           for(int i = 0; i <= sides; i++)
           {
               int const x = round(center_x + radius * cos(i*2.0*PI / sides));
               int const y = round(center_y - radius * sin(i*2.0*PI / sides));

               printf("vertex %d %d 0\n", x, y);
           }
       }

       int main(void)
       {
           puts("attribs 0 185 80");       /* color: green   */
           draw_polygon(300, 210, 150, 5); /* draws pentagon */

           puts("attribs 255 15 240");     /* color: magenta */
           draw_polygon(150, 320, 100, 7); /* draws heptagon */

           puts("!");
       }



