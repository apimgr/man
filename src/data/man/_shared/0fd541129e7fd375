     VVOOPP__DDEEAALLLLOOCCAATTEE(_s_t_r_u_c_t _v_n_o_d_e _*_v_p, _o_f_f___t _*_o_f_f_s_e_t, _o_f_f___t _*_l_e_n, _i_n_t _f_l_a_g_s,
