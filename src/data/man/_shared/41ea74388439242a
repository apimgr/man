SSYYNNOOPPSSIISS
     cchhppaassss [--aa _l_i_s_t] [--ee _e_x_p_i_r_e_t_i_m_e] [--pp _e_n_c_p_a_s_s] [--ss _n_e_w_s_h_e_l_l] [user]
