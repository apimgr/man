     If the aaccccff__ddnnss module is available in the kernel, the following code
     will enable the DNS accept filter on a socket _s_o_k.

             struct accept_filter_arg afa;

             bzero(&afa, sizeof(afa));
             strcpy(afa.af_name, "dnsready");
             setsockopt(sok, SOL_SOCKET, SO_ACCEPTFILTER, &afa, sizeof(afa));

