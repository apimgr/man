     _i_n_t
     aacccceessss(_c_o_n_s_t _c_h_a_r _*_p_a_t_h, _i_n_t _m_o_d_e);

     _i_n_t
     eeaacccceessss(_c_o_n_s_t _c_h_a_r _*_p_a_t_h, _i_n_t _m_o_d_e);

