EEXXAAMMPPLLEESS
       Below is a simple program that reallocates a block of memory in  cycles
       that  rise  to a peak before then cyclically reallocating the memory in
       smaller blocks that return to zero.  After compiling  the  program  and
       running the following commands, a graph of the memory usage of the pro‐
       gram can be found in the file _m_e_m_u_s_a_g_e_._p_n_g:

           $ mmeemmuussaaggee ----ddaattaa==mmeemmuussaaggee..ddaatt ..//aa..oouutt;
           ...
           Memory usage summary: heap total: 45200, heap peak: 6440, stack peak: 224
                   total calls  total memory  failed calls
            malloc|         1           400             0
           realloc|        40         44800             0  (nomove:40, dec:19, free:0)
            calloc|         0             0             0
              free|         1           440
           Histogram for block sizes:
             192-207             1   2% ================
           ...
            2192-2207            1   2% ================
            2240-2255            2   4% =================================
            2832-2847            2   4% =================================
            3440-3455            2   4% =================================
            4032-4047            2   4% =================================
            4640-4655            2   4% =================================
            5232-5247            2   4% =================================
            5840-5855            2   4% =================================
            6432-6447            1   2% ================
           $ mmeemmuussaaggeessttaatt mmeemmuussaaggee..ddaatt mmeemmuussaaggee..ppnngg;

   PPrrooggrraamm ssoouurrccee
       #include <stdio.h>
       #include <stdlib.h>

       #define CYCLES 20

       int
       main(int argc, char *argv[])
       {
           int i, j;
           size_t size;
           int *p;

           size = sizeof(*p) * 100;
           printf("malloc: %zu\n", size);
           p = malloc(size);

           for (i = 0; i < CYCLES; i++) {
               if (i < CYCLES / 2)
                   j = i;
               else
                   j--;

               size = sizeof(*p) * (j * 50 + 110);
               printf("realloc: %zu\n", size);
               p = realloc(p, size);

               size = sizeof(*p) * ((j + 1) * 150 + 110);
               printf("realloc: %zu\n", size);
               p = realloc(p, size);
           }

           free(p);
           exit(EXIT_SUCCESS);
       }

