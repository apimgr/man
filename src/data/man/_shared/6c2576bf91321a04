     iipp66aaddddrrccttll [--jj _j_a_i_l] [sshhooww]
     iipp66aaddddrrccttll [--jj _j_a_i_l] aadddd _p_r_e_f_i_x _p_r_e_c_e_d_e_n_c_e _l_a_b_e_l
     iipp66aaddddrrccttll [--jj _j_a_i_l] ddeelleettee _p_r_e_f_i_x
