       aauutthh ...... ppaamm__ffaaiilllloocckk..ssoo {preauth|authfail|authsucc}
                                [conf=_/_p_a_t_h_/_t_o_/_c_o_n_f_i_g_-_f_i_l_e]
                                [dir=_/_p_a_t_h_/_t_o_/_t_a_l_l_y_-_d_i_r_e_c_t_o_r_y]
