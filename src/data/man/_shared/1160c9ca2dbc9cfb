NNAAMMEE
     ccoommpprreessss, uunnccoommpprreessss, zzccaatt — compress and expand data (compress mode)

SSYYNNOOPPSSIISS
     ccoommpprreessss [--112233445566778899ccddffgghhllNNnnOOqqrrttvv] [--bb _b_i_t_s] [--oo _f_i_l_e_n_a_m_e] [--SS _s_u_f_f_i_x]
              [_f_i_l_e _._._.]
     uunnccoommpprreessss [--ccffhhllNNnnqqrrttvv] [--oo _f_i_l_e_n_a_m_e] [_f_i_l_e _._._.]
