           pentanomial.  This field is only used for a binary field F2ˆm.

       "m" (OOSSSSLL__PPKKEEYY__PPAARRAAMM__EECC__CCHHAARR22__MM) <integer>
       "tp" (OOSSSSLL__PPKKEEYY__PPAARRAAMM__EECC__CCHHAARR22__TTPP__BBAASSIISS) <integer>
       "k1" (OOSSSSLL__PPKKEEYY__PPAARRAAMM__EECC__CCHHAARR22__PPPP__KK11) <integer>
       "k2" (OOSSSSLL__PPKKEEYY__PPAARRAAMM__EECC__CCHHAARR22__PPPP__KK22) <integer>
