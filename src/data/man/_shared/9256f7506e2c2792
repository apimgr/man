     _i_n_t
     sshhmm__mmaapp(_s_t_r_u_c_t _f_i_l_e _*_f_p, _s_i_z_e___t _s_i_z_e, _o_f_f___t _o_f_f_s_e_t, _v_o_i_d _*_*_m_e_m_p);

