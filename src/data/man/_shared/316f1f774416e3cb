NNAAMMEE
       jpegtopnm - convert JPEG/JFIF file to PPM or PGM image


SSYYNNOOPPSSIISS
       jjppeeggttooppnnmm    [--ddcctt   {iinntt|ffaasstt|ffllooaatt}]   [--nnoossmmooootthh]   [--mmaaxxmmeemmoorryy   _N]
       [{--aaddoobbee|--nnoottaaddoobbee}] [--ccoommmmeennttss] [--dduummppeexxiiff] [--eexxiiff==_f_i_l_e_s_p_e_c]  [--mmuullttii‐‐
       ppllee] [--rreeppaaiirr] [--vveerrbboossee] [--ttrraacceelleevveell _N] [_f_i_l_e_n_a_m_e]

       Minimum  unique abbreviation of option is acceptable.  You may use dou‐
