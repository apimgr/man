     ccii — check in RCS revisions

SSYYNNOOPPSSIISS
     ccii [--qqVV] [--dd[_d_a_t_e]] [--ff[_r_e_v]] [--II[_r_e_v]] [--ii[_r_e_v]] [--jj[_r_e_v]] [--kk[_r_e_v]]
