     _s_s_i_z_e___t
     ccooppyy__ffiillee__rraannggee(_i_n_t _i_n_f_d, _o_f_f___t _*_i_n_o_f_f_p, _i_n_t _o_u_t_f_d, _o_f_f___t _*_o_u_t_o_f_f_p,
