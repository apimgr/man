       named‐checkzone - zone file validity checking or converting tool

SSYYNNOOPPSSIISS
       nnaammeedd--cchheecckkzzoonnee  [--dd]  [--hh]  [--jj]  [--qq] [--vv] [--cc class] [--ff format] [--FF
       format] [--JJ filename] [--ii mode] [--kk mode] [--mm mode] [--MM mode] [--nn mode]
       [--ll ttl] [--LL serial] [--oo filename] [--rr mode] [--ss style] [--SS  mode]  [--tt
       directory]  [--TT  mode]  [--ww directory] [--DD] [--WW mode] {zonename} {file‐
