     ppoorrttbbuummpp — tweaks port revisions and library versions

SSYYNNOOPPSSIISS
     ppoorrttbbuummpp [--llMMmmnnrrvv] [--WW _w_l_i_b] [--ww _w_l_i_b] [_p_o_r_t_r_e_f _._._.]

