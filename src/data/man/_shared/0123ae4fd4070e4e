          [--ll _t_i_m_e_l_i_m_i_t] [--ss _s_c_o_p_e] [--ww _s_e_c_r_e_t] [--yy _s_e_c_r_e_t_f_i_l_e] [--zz _s_i_z_e_l_i_m_i_t]
