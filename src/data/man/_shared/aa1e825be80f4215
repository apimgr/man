       with the data accompanying a signal sent by ssiiggqquueeuuee(3).

EEXXAAMMPPLLEESS
       The program below accepts the signals SSIIGGIINNTT and SSIIGGQQUUIITT via a signalfd
       file descriptor.  The program terminates after accepting a SSIIGGQQUUIITT sig‐
       nal.  The following shell session demonstrates the use of the program:

           $ ..//ssiiggnnaallffdd__ddeemmoo
           ^^CC                   # Control-C generates SIGINT
           Got SIGINT
           ^^CC
           Got SIGINT
           ^^\\                    # Control-\ generates SIGQUIT
           Got SIGQUIT
           $

   PPrrooggrraamm ssoouurrccee

       #include <err.h>
       #include <signal.h>
       #include <stdio.h>
       #include <stdlib.h>
       #include <sys/signalfd.h>
       #include <sys/types.h>
       #include <unistd.h>

       int
       main(void)
       {
           int                      sfd;
           ssize_t                  s;
           sigset_t                 mask;
           struct signalfd_siginfo  fdsi;

           sigemptyset(&mask);
           sigaddset(&mask, SIGINT);
           sigaddset(&mask, SIGQUIT);

           /* Block signals so that they aren't handled
              according to their default dispositions.  */

           if (sigprocmask(SIG_BLOCK, &mask, NULL) == -1)
               err(EXIT_FAILURE, "sigprocmask");

           sfd = signalfd(-1, &mask, 0);
           if (sfd == -1)
               err(EXIT_FAILURE, "signalfd");

           for (;;) {
               s = read(sfd, &fdsi, sizeof(fdsi));
               if (s != sizeof(fdsi))
                   err(EXIT_FAILURE, "read");

               if (fdsi.ssi_signo == SIGINT) {
                   printf("Got SIGINT\n");
               } else if (fdsi.ssi_signo == SIGQUIT) {
                   printf("Got SIGQUIT\n");
                   exit(EXIT_SUCCESS);
               } else {
                   printf("Read unexpected signal\n");
               }
           }
       }

