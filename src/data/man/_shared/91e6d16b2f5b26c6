     aatt [--qq _q_u_e_u_e] [--ff _f_i_l_e] [--mmllddbbvv] _t_i_m_e
     aatt [--qq _q_u_e_u_e] [--ff _f_i_l_e] [--mmllddbbvv] --tt [[_C_C]_Y_Y]_M_M_D_D_h_h_m_m[._S_S]
