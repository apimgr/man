     ppoossiixx__ooppeennpptt — open a pseudo-terminal device

LLIIBBRRAARRYY
     Standard C Library (libc, -lc)

SSYYNNOOPPSSIISS
     ##iinncclluuddee <<ffccnnttll..hh>>
