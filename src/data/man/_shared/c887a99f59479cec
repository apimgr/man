            [--FF _d_e_v_i_c_e] [--ff _d_e_v_i_c_e] [--jj _f_l_a_g] [--LL _a_d_d_r] [--mm _m_o_d_e] [--QQ _p_o_r_t]
            [--qq _p_o_r_t] [--rr _r_a_t_e] [--ss _n_a_m_e] [--tt _m_o_d_e] [--UU _u_n_i_t] [--vv _v_o_l_u_m_e]
