     aa6644ll, ll6644aa, ll6644aa__rr — convert between a long integer and a base-64 ASCII
     string

LLIIBBRRAARRYY
     Standard C Library (libc, -lc)

SSYYNNOOPPSSIISS
     ##iinncclluuddee <<ssttddlliibb..hh>>

     _l_o_n_g
     aa6644ll(_c_o_n_s_t _c_h_a_r _*_s);

     _c_h_a_r _*
     ll6644aa(_l_o_n_g _i_n_t _l);

     _i_n_t
