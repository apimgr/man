DDEESSCCRRIIPPTTIIOONN
     The DDEEVV__MMOODDUULLEE() macro declares a device driver kernel module.  It fills
     in a _m_o_d_u_l_e_d_a_t_a___t structure and then calls DDEECCLLAARREE__MMOODDUULLEE() with the cor‐
     rect args, where _n_a_m_e is the name of the module and _e_v_h (with its argu‐
     ment _a_r_g) is the event handler for the module (refer to DECLARE_MODULE(9)
     for more information).  The event handler is supposed to create the de‐
     vice with mmaakkee__ddeevv() on load and to destroy it when it is unloaded using
     ddeessttrrooyy__ddeevv().

EEXXAAMMPPLLEESS
     #include <sys/module.h>
     #include <sys/conf.h>

     static struct cdevsw foo_devsw = { ... };

     static struct cdev *sdev;

     static int
     foo_load(module_t mod, int cmd, void *arg)
     {
         int err = 0;

         switch (cmd) {
         case MOD_LOAD:
             sdev = make_dev(&foo_devsw, 0, UID_ROOT, GID_WHEEL, 0600, "foo");
             break;          /* Success*/

         case MOD_UNLOAD:
         case MOD_SHUTDOWN:
             destroy_dev(sdev);
             break;          /* Success*/

         default:
             err = EINVAL;
             break;
         }

         return(err);
     }

     DEV_MODULE(foo, foo_load, NULL);

