     struct m_tag {
             SLIST_ENTRY(m_tag)      m_tag_link;     /* List of packet tags */
             uint16_t                m_tag_id;       /* Tag ID */
             uint16_t                m_tag_len;      /* Length of data */
             uint32_t                m_tag_cookie;   /* ABI/Module ID */
