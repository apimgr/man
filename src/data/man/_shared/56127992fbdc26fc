     ffcclloossee, ffddcclloossee, ffcclloosseeaallll — close a stream

LLIIBBRRAARRYY
     Standard C Library (libc, -lc)

SSYYNNOOPPSSIISS
     ##iinncclluuddee <<ssttddiioo..hh>>

     _i_n_t
     ffcclloossee(_F_I_L_E _*_s_t_r_e_a_m);

     _i_n_t
     ffddcclloossee(_F_I_L_E _*_s_t_r_e_a_m, _i_n_t _*_f_d_p);

