     cceerrttccttll — tool for managing trusted and untrusted TLS certificates

SSYYNNOOPPSSIISS
     cceerrttccttll [--vv] lliisstt
     cceerrttccttll [--vv] uunnttrruusstteedd
     cceerrttccttll [--nnUUvv] [--DD _d_e_s_t_d_i_r] [--MM _m_e_t_a_l_o_g] rreehhaasshh
     cceerrttccttll [--nnvv] uunnttrruusstt _f_i_l_e
