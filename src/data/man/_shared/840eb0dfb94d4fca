           [--PP _p_p_i_d] [--UU _u_i_d] [--cc _c_l_a_s_s] [--dd _d_e_l_i_m] [--gg _p_g_r_p] [--jj _j_a_i_l]
           [--ss _s_i_d] [--tt _t_t_y] [--uu _e_u_i_d] _p_a_t_t_e_r_n _._._.
     ppkkiillll [--_s_i_g_n_a_l] [--IILLaaffiillnnoovvxx] [--FF _p_i_d_f_i_l_e] [--GG _g_i_d] [--MM _c_o_r_e] [--NN _s_y_s_t_e_m]
