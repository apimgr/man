            eeaacchhrreessuulltt(_c_a_d_d_r___t _o_u_t, _c_o_n_s_t _s_t_r_u_c_t _n_e_t_b_u_f _* _a_d_d_r, _c_o_n_s_t _s_t_r_u_c_t
