# =============================================================================
# Build Stage - Compile Go binary
# =============================================================================
FROM casjaysdev/go:latest AS builder

RUN apk add --no-cache git bash

ARG TARGETARCH
ARG VERSION=dev
ARG BUILD_EPOCH
ARG COMMIT_ID
ARG OFFICIAL_SITE

WORKDIR /build

# Copy go.mod first for layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
# BuildDate is NOT embedded - it is derived from BuildEpoch at process start
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOFLAGS=-buildvcs=false go build \
    -buildvcs=false -trimpath \
    -ldflags "-s -w -X 'main.Version=${VERSION}' -X 'main.CommitID=${COMMIT_ID}' -X 'main.BuildEpoch=${BUILD_EPOCH}' -X 'main.OfficialSite=${OFFICIAL_SITE}'" \
    -o /build/binary/casman ./src

# =============================================================================
# Runtime Stage - Minimal Alpine image (devel — same as release, debug mode)
# =============================================================================
FROM alpine:latest

# ARGs for build-time values (set by docker build --build-arg)
ARG VERSION=dev
ARG BUILD_DATE
ARG BUILD_EPOCH
ARG COMMIT_ID
ARG LICENSE=MIT

# Static Labels
LABEL maintainer="casapps <casapps@example.com>" \
      org.opencontainers.image.vendor="apimgr" \
      org.opencontainers.image.authors="apimgr" \
      org.opencontainers.image.title="man" \
      org.opencontainers.image.base.name="man" \
      org.opencontainers.image.description="man - universal man pages (alpine, debug mode)" \
      org.opencontainers.image.url="https://github.com/apimgr/man" \
      org.opencontainers.image.source="https://github.com/apimgr/man" \
      org.opencontainers.image.documentation="https://github.com/apimgr/man" \
      org.opencontainers.image.vcs-type="Git" \
      com.github.containers.toolbox="false"

# Dynamic Labels (from ARGs)
LABEL org.opencontainers.image.licenses="${LICENSE}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.schema-version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT_ID}"

# Upgrade preinstalled base packages first so runtime libs carry the latest
# security patches, not whatever shipped in the cached alpine:latest base layer
RUN apk upgrade --no-cache

# Install required packages
# NOTE: Tor binary installed but NOT configured here - binary handles all Tor setup
RUN apk add --no-cache \
    git \
    curl \
    bash \
    tini \
    tor

# NO directory creation - binary handles ALL setup based on env vars
# This allows users to override CONFIG_DIR, DATA_DIR, etc.
# Docker volume mounts auto-create mount points

# Copy binary from builder stage (multi-stage build)
COPY --from=builder /build/binary/casman /usr/local/bin/casman

# Copy BUILD-TIME overlay (entrypoint.sh) from docker/file_system/ into image
# Note: This is docker/file_system/ (build context), NOT runtime ./rootfs/ volumes
COPY docker/file_system/ /

# Copy Dockerfile to image (for reference and backup)
COPY docker/Dockerfile.dev /root/Dockerfile

# Make all binaries/scripts in /usr/local/bin executable (755)
RUN chmod 755 /usr/local/bin/*

# Set environment
# Note: Tor available (binary installed) but server binary controls Tor startup
# MODE=devel is baked in here (unlike the release Dockerfile) — this image
# exists solely to run the binary in debug mode, tagged :devel
ENV TZ=America/New_York \
    MODE=devel \
    DEBUG=true

# Expose internal port (always 80)
EXPOSE 80

# Stop signal for graceful shutdown
STOPSIGNAL SIGRTMIN+3

# Health check (long start period for services that need initialization)
HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 \
    CMD /usr/local/bin/casman --status || exit 1

# Use tini as init with signal propagation
# -p SIGTERM: propagate SIGTERM to child processes
ENTRYPOINT [ "tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh" ]
